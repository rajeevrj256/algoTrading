# Copy to .env and fill in. .env is gitignored — NEVER commit real credentials.
# Spring loads this via spring.config.import (see application.yml); real OS
# environment variables with the same names also work and take precedence.

# ── PostgreSQL (Neon) ─────────────────────────────────────────
DB_URL=jdbc:postgresql://<host>:5432/<database>
# Flyway-only DIRECT endpoint (Neon: same host WITHOUT "-pooler").
# Advisory locks break through PgBouncer; omit only if DB_URL is already direct.
DB_DIRECT_URL=jdbc:postgresql://<direct-host>:5432/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ── Groww Trading API (https://groww.in/user/profile/trading-apis)
GROWW_API_KEY=
GROWW_API_SECRET=
# Optional: manually-generated daily access token (skips key/secret exchange)
GROWW_ACCESS_TOKEN=

# ── Telegram alerts (optional) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
